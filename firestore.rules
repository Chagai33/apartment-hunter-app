rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user is the owner of the document (standard pattern)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if user is a member of the given group
    function isGroupMember(groupId) {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/groups/$(groupId)) &&
             request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    // --- COLLECTION RULES ---

    // 1. Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // 2. Groups Collection
    match /groups/{groupId} {
      // Read: Allow if authenticated (needed to find groups by code)
      allow read: if isAuthenticated();

      // Create: Allow if authenticated and setting themselves as creator
      // Also validate that they add themselves to the members array
      allow create: if isAuthenticated() && (
        request.resource.data.createdBy == request.auth.uid &&
        request.auth.uid in request.resource.data.members
      );

      // Update: Allow if member or joining (present in the resulting members list)
      allow update: if isAuthenticated() && (
        request.auth.uid in request.resource.data.members ||
        request.auth.uid in resource.data.members
      );

      // Delete: Allow if user is the creator (owner)
      allow delete: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid
      );
    }

    // 3. Apartments Collection
    match /apartments/{apartmentId} {
      // Read: Allow ONLY if user is a member of the apartment's group
      allow read: if isGroupMember(resource.data.groupId);

      // Create: Allow if user is a member of the target group
      allow create: if isGroupMember(request.resource.data.groupId) &&
                    request.resource.data.createdBy == request.auth.uid;

      // Update/Delete: Allow if user is a member of the apartment's group
      allow update, delete: if isGroupMember(resource.data.groupId);
    }
  }
}
